{
    "id": "org.freedesktop.Sdk.Extension.php84",
    "branch": "24.08",
    "runtime": "org.freedesktop.Sdk",
    "sdk": "org.freedesktop.Sdk",
    "runtime-version": "24.08",
    "sdk-extensions": [],
    "build-extension": true,
    "separate-locales": false,
    "build-options": {
        "no-debuginfo": true,
        "strip": true,
        "prefix": "/usr/lib/sdk/php84",
        "prepend-path": "/usr/lib/sdk/php84/bin",
        "prepend-ld-library-path": "/usr/lib/sdk/php84/lib",
        "prepend-pkg-config-path": "/usr/lib/sdk/php84/lib/pkgconfig",
        "env": {
            "PHP_INI_DIR": "/usr/lib/sdk/php84/etc/php"
        }
    },
    "modules": [
        {
            "name": "libzip",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_TOOLS=OFF",
                "-DBUILD_EXAMPLES=OFF",
                "-DBUILD_DOC=OFF"
            ],
            "cleanup": [
                "/include",
                "/lib/cmake",
                "/lib/pkgconfig",
                "*.a",
                "*.la"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/nih-at/libzip/releases/download/v1.11.4/libzip-1.11.4.tar.xz",
                    "sha256": "8a247f57d1e3e6f6d11413b12a6f28a9d388de110adc0ec608d893180ed7097b",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 10649,
                        "stable-only": true,
                        "url-template": "https://github.com/nih-at/libzip/releases/download/v$version/libzip-$version.tar.xz"
                    }
                }
            ],
            "post-install": [
                "install -Dm644 LICENSE ${FLATPAK_DEST}/share/licenses/libzip/LICENSE"
            ]
        },
        {
            "name": "php",
            "buildsystem": "autotools",
            "config-opts": [
                "--enable-libgcc",
                "--enable-option-checking=fatal",
                "--with-config-file-path=/usr/lib/sdk/php84/etc/php",
                "--with-config-file-scan-dir=/usr/lib/sdk/php84/etc/php/conf.d:/app/etc/php:/var/config/php/8.4/ini",
                "--disable-cgi",
                "--enable-intl",
                "--enable-mbstring",
                "--enable-opcache",
                "--enable-pcntl",
                "--with-bz2",
                "--with-curl",
                "--with-openssl",
                "--with-system-ciphers",
                "--with-zip",
                "--with-zlib"
            ],
            "post-install": [
                "install -Dm644 php.ini-development ${PHP_INI_DIR}/php.ini",
                "install -Dm644 opcache.ini ${PHP_INI_DIR}/conf.d/10-opcache.ini",
                "install -Dm644 LICENSE ${FLATPAK_DEST}/share/licenses/php/LICENSE"
            ],
            "cleanup": [
                "/include",
                "/php",
                "*.a",
                "*.la"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://www.php.net/distributions/php-8.4.21.tar.xz",
                    "sha256": "7cf5d8ab12c3b2016875bcfaec71bef1ef0b07bed6148f2c447577074431f984",
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://www.php.net/releases/index.php?json&version=8.4&max=1",
                        "version-query": "keys[0]",
                        "url-query": "\"https://www.php.net/distributions/php-\" + $version + \".tar.xz\"",
                        "is-main-source": true
                    }
                },
                {
                    "type": "file",
                    "path": "files/php/opcache.ini"
                }
            ]
        },
        {
            "name": "apcu",
            "buildsystem": "autotools",
            "config-opts": [
                "--with-php-config=/usr/lib/sdk/php84/bin/php-config"
            ],
            "post-install": [
                "install -Dm755 modules/apcu.so $(php -r 'echo ini_get(\"extension_dir\");')/apcu.so",
                "install -Dm644 apcu.ini ${PHP_INI_DIR}/conf.d/40-apcu.ini",
                "install -Dm644 LICENSE ${FLATPAK_DEST}/share/licenses/apcu/LICENSE"
            ],
            "cleanup": [
                "/include",
                "*.a"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/krakjoe/apcu/archive/v5.1.28.tar.gz",
                    "sha256": "0e60ba9d0fa4021c57a70c071f3d8f71de236275d084e560d5959fec4edd8c32",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 11010,
                        "stable-only": true,
                        "url-template": "https://github.com/krakjoe/apcu/archive/v$version.tar.gz"
                    }
                },
                {
                    "type": "file",
                    "path": "files/apcu/apcu.ini"
                },
                {
                    "type": "shell",
                    "commands": [
                        "${FLATPAK_DEST}/bin/phpize"
                    ]
                }
            ]
        },
        {
            "name": "xdebug",
            "buildsystem": "autotools",
            "config-opts": [
                "--with-php-config=/usr/lib/sdk/php84/bin/php-config"
            ],
            "post-install": [
                "install -Dm755 modules/xdebug.so $(php -r 'echo ini_get(\"extension_dir\");')/xdebug.so",
                "install -Dm644 xdebug.ini ${PHP_INI_DIR}/conf.d/15-xdebug.ini",
                "install -Dm644 LICENSE ${FLATPAK_DEST}/share/licenses/xdebug/LICENSE"
            ],
            "cleanup": [
                "/include",
                "*.a",
                "*.la"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://xdebug.org/files/xdebug-3.5.1.tgz",
                    "sha256": "0f26849a5edf3d9120edc100219854599d54f923a8a4d1cb4fe4403520e49678",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 13302,
                        "stable-only": true,
                        "url-template": "https://xdebug.org/files/xdebug-$version.tgz"
                    }
                },
                {
                    "type": "file",
                    "path": "files/xdebug/xdebug.ini"
                },
                {
                    "type": "shell",
                    "commands": [
                        "${FLATPAK_DEST}/bin/phpize"
                    ]
                }
            ]
        },
        {
            "name": "composer",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm755 composer.phar ${FLATPAK_DEST}/bin/composer"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://getcomposer.org/download/2.10.0/composer.phar",
                    "sha256": "a346538851988ead111d11e3cbd7d372eeba44abd0af412e09890d3c21ea6c31",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 9710,
                        "stable-only": true,
                        "url-template": "https://getcomposer.org/download/$version/composer.phar"
                    }
                }
            ]
        },
        {
            "name": "phive",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm0755 phive.phar ${FLATPAK_DEST}/bin/phive"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://github.com/phar-io/phive/releases/download/0.16.0/phive-0.16.0.phar",
                    "sha256": "1525f25afec4bcdc0aa8db7bb4b0063851332e916698daf90c747461642a42ed",
                    "dest-filename": "phive.phar",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 143959,
                        "stable-only": true,
                        "url-template": "https://github.com/phar-io/phive/releases/download/$version/phive-$version.phar"
                    }
                }
            ]
        },
        {
            "name": "scripts",
            "buildsystem": "simple",
            "build-commands": [
                "cp enable.sh ${FLATPAK_DEST}/"
            ],
            "sources": [
                {
                    "type": "script",
                    "dest-filename": "enable.sh",
                    "commands": [
                        "export PATH=$PATH:/usr/lib/sdk/php84/bin:/var/config/composer/vendor/bin"
                    ]
                }
            ]
        }
    ]
}
